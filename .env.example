# ==============================================================================
# SAIL Material Management Module - Salem Steel Plant
# Environment Configuration (Render Production & Local)
# ==============================================================================

# Server Environment
ENVIRONMENT=production
PORT=10000

# Database Connection:
# - SQLite (Default): sqlite:///sail_procurement.db
# - Render PostgreSQL: Automatically supplied if a Render PostgreSQL instance is linked,
#   e.g. postgresql://user:password@hostname:5432/dbname
DATABASE_URL=sqlite:///sail_procurement.db

# Storage configuration
UPLOADS_DIR=uploads
MAX_FILE_SIZE_MB=30

# CORS Allowed Origins (Comma-separated or * for universal access)
ALLOWED_ORIGINS=*

# Optional AI API Keys (Leave empty to use built-in rule-based extraction engine)
GEMINI_API_KEY=
OPENAI_API_KEY=
